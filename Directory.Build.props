<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <Deterministic>true</Deterministic>
    <NativeSourceRoot Condition="Exists('$(MSBuildThisFileDirectory)..\Cpp2IL-development\Cpp2IL-development\Cpp2IL.Core\Cpp2IL.Core.csproj')">$(MSBuildThisFileDirectory)..\</NativeSourceRoot>
    <NativeSourceRoot Condition="'$(NativeSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Cpp2IL-development\Cpp2IL-development\Cpp2IL.Core\Cpp2IL.Core.csproj')">$(MSBuildThisFileDirectory)..\..\</NativeSourceRoot>
  </PropertyGroup>
</Project>
